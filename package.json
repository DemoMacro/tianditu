{
  "name": "tianditu",
  "version": "0.0.0",
  "description": "Utility libraries for tianditu, powered by Demo Macro.",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" -r dev",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "check": "vp check --fix",
    "version": "pnpm --filter \"./packages/**\" -r exec basis version",
    "publish": "pnpm --filter \"./packages/**\" -r exec basis publish",
    "postinstall": "pnpm build && vp config && basis git setup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/tianditu.git"
  },
  "keywords": [
    "utility",
    "libraries",
    "tianditu",
    "map"
  ],
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://imst.xyz/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DemoMacro/tianditu/issues"
  },
  "homepage": "https://github.com/DemoMacro/tianditu#readme",
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@types/node": "26.1.2",
    "vite-plus": "0.2.8"
  }
}