{
  "name": "tianditu",
  "version": "0.0.0",
  "private": true,
  "description": "Utility libraries for tianditu — one set of framework-agnostic definitions powering both Vue 3 components and Web Components, plus a typed REST service client",
  "keywords": [
    "custom-elements",
    "gis",
    "lbs",
    "map",
    "rest",
    "sdk",
    "tianditu",
    "typescript",
    "vue",
    "vue3",
    "web-components"
  ],
  "homepage": "https://github.com/DemoMacro/tianditu#readme",
  "bugs": {
    "url": "https://github.com/DemoMacro/tianditu/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/tianditu.git"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" -r dev",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "docs:dev": "pnpm --filter @tianditu/docs dev",
    "docs:build": "pnpm --filter @tianditu/docs build",
    "docs:generate": "pnpm --filter @tianditu/docs generate",
    "docs:preview": "pnpm --filter @tianditu/docs preview",
    "check": "vp check --fix",
    "version": "pnpm --filter \"./packages/**\" -r exec basis version",
    "publish": "pnpm --filter \"./packages/**\" -r exec basis publish",
    "postinstall": "pnpm build && vp config && basis git setup"
  },
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@types/node": "26.1.2",
    "vite-plus": "0.2.8"
  }
}
