{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": false,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "es2017"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noImplicitAny": false,
    "strict": true,
    "target": "es2017",
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react",
    "jsxFactory": "h",
    "skipLibCheck": true
  },
  "include": ["src"],
  "files": ["../core/types/index.d.ts"],
  "exclude": ["node_modules"]
}
