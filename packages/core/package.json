{
  "name": "@tianditu/core",
  "version": "0.1.0",
  "description": "Headless core for tianditu — idempotent SDK loader, map session, and lifecycle orchestration shared by every framework adapter, with a component definition layer for Vue and Web Components",
  "keywords": [
    "core",
    "framework-agnostic",
    "gis",
    "headless",
    "lbs",
    "map",
    "overlay",
    "sdk-loader",
    "tianditu",
    "typescript"
  ],
  "homepage": "https://github.com/DemoMacro/tianditu#readme",
  "bugs": {
    "url": "https://github.com/DemoMacro/tianditu/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/tianditu.git"
  },
  "files": [
    "dist",
    "types"
  ],
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./modular": {
      "types": "./types/modular.d.ts"
    }
  },
  "scripts": {
    "build": "vp pack && node ./scripts/inject-types.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@vue/reactivity": "3.4.37"
  },
  "devDependencies": {}
}
